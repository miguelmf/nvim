{
  "Anki Basic Card": {
    "prefix": "anki",
    "body": [
      "# Note",
      "",
      "model: Basic",
      "tags: ${1:tag1, tag2}",
      "deck: ${2:myDeckName}",
      "",
      "## Front",
      "",
      "${3:Front of the card text here}",
      "",
      "## Back",
      "",
      "${4:Back of the card text here}",
      ""
    ],
    "description": "Create a new Anki Basic card"
  },

  "Anki Basic Card 2": {
    "prefix": "aa",
    "body": [
      "# Note",
      "",
      "model: Basic",
      "tags: ${1:tag1}",
      "deck: all",
      "",
      "## Front",
      "",
      "${2:question}",
      "",
      "## Back",
      "",
      "${3:answer}",
      "",
      "<!-- --- -->",
      "",
      ""
    ],
    "description": "Create a new Anki Basic card for the 'all' deck"
  },

  "html highlight span": {
    "prefix": "hi",
    "body": [
      "<span class=\"highlight\">$1</span>"
    ],
    "description": "Wrap highlighted text in a span with the highlight class"
  }
}
